{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mavibelge://schema/news.schema.json",
  "title": "Mavi Belge Faz 7 Haber Manifest Kaydı",
  "description": "wordpress-site/data/content/news.manifest.json içindeki her 'records[]' elemanının şekli. Kaynak: tanitim-site/assets/data/news.js (6 gerçek haber/duyuru). Kaynaktaki 'image' alanı aktarılmaz. Bkz. docs/content-import-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_key", "source_index", "slug", "title", "published_on", "news_type", "summary", "body", "source"],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "source_key": { "type": "string", "pattern": "^news:[a-z0-9]+(-[a-z0-9]+)*$" },
    "source_index": { "type": "integer", "minimum": 0 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "published_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "news_type": { "type": "string", "enum": ["haber", "duyuru"] },
    "summary": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
