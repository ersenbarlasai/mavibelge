{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mavibelge://schema/sector.schema.json",
  "title": "Mavi Belge Faz 6A Sektör Manifest Kaydı",
  "description": "wordpress-site/data/content/sectors.manifest.json içindeki her 'records[]' elemanının şekli. Bkz. raporlar/veri-aktarim-raporlari/faz6a-manifest-sozlesmesi.md §3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_key", "source_index", "slug", "name", "description", "icon", "image", "source"],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "source_key": { "type": "string", "pattern": "^sector:[a-z0-9]+(-[a-z0-9]+)*$" },
    "source_index": { "type": "integer", "minimum": 0 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "icon": { "type": "string" },
    "image": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
