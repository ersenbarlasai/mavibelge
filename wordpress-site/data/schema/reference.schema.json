{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mavibelge://schema/reference.schema.json",
  "title": "Mavi Belge Referans Manifest Kaydı (Faz 12b — gerçek logo)",
  "description": "wordpress-site/data/content/references.manifest.json içindeki her 'records[]' elemanının şekli. Kaynak: wordpress-site/data/sources/reference-logos/reference-logos.manifest.json (onaylı canlı referans sayfasından bir kez alınmış 15 logo). 'name_status' her zaman 'unverified': firma adı görselden tahmin edilmez; 'name' nötr sıra etiketidir. Logo dosyası içe aktarımda gerçek WordPress attachment'ına çevrilir. Bkz. docs/content-import-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_key", "source_index", "name", "slug", "logo_file", "logo_sha256", "logo_bytes", "logo_width", "logo_height", "alt", "name_status", "source"],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "source_key": { "type": "string", "pattern": "^reference:[a-z0-9]+(-[a-z0-9]+)*$" },
    "source_index": { "type": "integer", "minimum": 0 },
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "logo_file": { "type": "string", "pattern": "^wordpress-site/data/sources/reference-logos/ref-[0-9]{2}[.]png$" },
    "logo_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "logo_bytes": { "type": "integer", "minimum": 1 },
    "logo_width": { "type": "integer", "minimum": 1 },
    "logo_height": { "type": "integer", "minimum": 1 },
    "alt": { "type": "string", "minLength": 1 },
    "name_status": { "type": "string", "enum": ["unverified"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
