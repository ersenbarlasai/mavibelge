{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mavibelge://schema/fee.schema.json",
  "title": "Mavi Belge Faz 6A Ücret Manifest Kaydı",
  "description": "wordpress-site/data/content/fees.manifest.json içindeki her 'records[]' elemanının şekli. Bkz. raporlar/veri-aktarim-raporlari/faz6a-manifest-sozlesmesi.md §5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_key", "source_index", "profession_name", "level", "sector_slug",
    "qualification_code", "qualification_source_key", "pricing_type", "price_options",
    "min_amount_kurus", "max_amount_kurus", "vat_included", "certificate_print_fee_kurus",
    "source_name", "source_page", "source_attachment_id",
    "planned_tariff_period", "planned_record_status", "planned_valid_from", "planned_valid_until",
    "source"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "source_key": { "type": "string", "pattern": "^fee:[a-z0-9]+(-[a-z0-9]+)*:[1-8]:[a-z0-9]+(-[a-z0-9]+)*$" },
    "source_index": { "type": "integer", "minimum": 0 },
    "profession_name": { "type": "string", "minLength": 1 },
    "level": { "type": "integer", "minimum": 1, "maximum": 8 },
    "sector_slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "qualification_code": { "type": "string" },
    "qualification_source_key": { "type": ["string", "null"], "pattern": "^qualification:[0-9]{2}UY[0-9]{4}-[0-9]{1,2}(/[0-9]{2})?$" },
    "pricing_type": { "type": "string", "enum": ["single", "unit", "package", "multiple"] },
    "price_options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "units", "amount_kurus", "sort_order"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "units": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 50 } },
          "amount_kurus": { "type": "integer", "minimum": 1 },
          "sort_order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "min_amount_kurus": { "type": "integer", "minimum": 1 },
    "max_amount_kurus": { "type": "integer", "minimum": 1 },
    "vat_included": { "type": "boolean" },
    "certificate_print_fee_kurus": { "type": "integer", "minimum": 0 },
    "source_name": { "type": "string" },
    "source_page": { "type": ["integer", "null"], "minimum": 1 },
    "source_attachment_id": { "type": "integer", "const": 0 },
    "planned_tariff_period": { "type": "string" },
    "planned_record_status": { "type": "string", "enum": ["draft", "active", "archived"] },
    "planned_valid_from": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
    "planned_valid_until": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
